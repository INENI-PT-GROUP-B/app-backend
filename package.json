    "lint": "eslint .",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "fastify": "5.8.5",
    "pg": "8.21.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.18.13",
    "@types/pg": "8.20.0",
    "drizzle-kit": "0.31.10",
    "eslint": "10.4.0",
    "tsx": "4.22.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.4",
    "vitest": "4.1.7"
  }
}
