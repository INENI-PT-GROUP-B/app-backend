{
  "name": "app-backend",
  "version": "0.0.0",
  "private": true,
  "description": "Application backend (REST API) for the property-management app",
  "type": "module",
  "engines": {
    "node": "22.22.3"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc --project tsconfig.json",
